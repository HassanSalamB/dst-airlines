flowchart TB
    subgraph live_lane[" "]
        direction LR
        opensky["OpenSky<br/>state vectors"] --> collector["Python collector<br/>normalize + classify"]
        collector --> kafka["Kafka<br/>gulf.live_flights"]
        kafka --> consumer["Consumer<br/>validate + persist"]
        consumer --> mongo[("MongoDB<br/>recent observations")]
    end

    subgraph analytics_lane[" "]
        direction LR
        generator["Versioned Saudi/UAE<br/>simulation"] --> postgres[("PostgreSQL<br/>operational history")]
        generator --> training["Chronological ML training<br/>fit → calibrate → evaluate"]
        training --> artifact[("Calibrated CatBoost<br/>artifact + model card")]
        postgres --> graphload["Route graph loader"]
        graphload --> neo4j[("Neo4j<br/>airport-route graph")]
    end

    mongo --> api["FastAPI<br/>shared product interface"]
    postgres --> api
    neo4j --> api
    artifact --> api

    api --> dashboard["Dash / Plotly<br/>operational views"]
    weather["Open-Meteo"] --> dashboard
    routes["ADSBDB"] --> dashboard
    dashboard --> user["Portfolio visitor<br/>or operations user"]

    api --> metrics["/metrics"] --> prometheus["Prometheus"] --> grafana["Grafana"]

