# Copy this file to .env.dev and replace every placeholder.
POSTGRES_PASSWORD=replace-with-a-development-password
PGADMIN_DEFAULT_PASSWORD=replace-with-a-development-password
NEO4J_PASSWORD=replace-with-a-development-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-development-password
API_ENV=development
DEBUG=true
OPENSKY_POLL_SECONDS=60
# Optional OAuth2 credentials. Anonymous access works but has a much smaller quota.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
