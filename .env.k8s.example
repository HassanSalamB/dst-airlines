# Copy this file to .env.k8s and replace every placeholder.
POSTGRES_PASSWORD=replace-with-a-strong-password
NEO4J_PASSWORD=replace-with-a-strong-password
NEO4J_AUTH=neo4j/replace-with-a-strong-password
DATABASE_URL=postgresql+psycopg2://airlines:replace-with-a-url-encoded-password@db:5432/airlines_db

# Keep these defaults when images were built inside Minikube.
API_IMAGE=dst-airlines-api:ci
DASHBOARD_IMAGE=dst-airlines-dashboard:ci
